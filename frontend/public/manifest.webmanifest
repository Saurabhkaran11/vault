{
  "name": "Vault — everything, one place",
  "short_name": "Vault",
  "description": "Personal knowledge hub: notes, videos, reading, documents, to-dos, boards and finance.",
  "start_url": "/",
  "display": "standalone",
  "background_color": "#EFF3F8",
  "theme_color": "#0F2237",
  "icons": [
    {
      "src": "/icon.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "any"
    },
    {
      "src": "/icons/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icons/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icons/maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "share_target": {
    "action": "/",
    "method": "GET",
    "params": {
      "title": "vcap_title",
      "text": "vcap_text",
      "url": "vcap_url"
    }
  }
}