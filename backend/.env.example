# Owner settings for the optional backend. Full guide: docs/runbook.md
# Required on a public deployment
DATABASE_URL=postgresql+asyncpg://vault:vault@localhost:5433/vault
REDIS_URL=redis://localhost:6380
AUTH_MODE=dev
# AUTH_MODE=jwt also needs these. The app refuses to start with public CORS origins in dev mode.
JWT_ISSUER=
JWT_JWKS_URL=
CORS_ORIGINS=http://localhost:3100

# Optional: file uploads
S3_BUCKET=
S3_REGION=us-east-1
S3_ENDPOINT_URL=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Optional: Google calendar and Drive
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=
CALENDAR_TOKEN_KEY=

# Optional: error reporting
SENTRY_DSN=

# Optional: real embeddings for search. Without them a keyless hashing embedder is used.
# If set with a paid provider, the owner pays for indexing.
EMBEDDINGS_URL=
EMBEDDINGS_API_KEY=

# Local use only. Ignored unless AUTH_MODE=dev. On a public deployment visitors use their own AI key.
CHAT_URL=
CHAT_API_KEY=
CHAT_MODEL=
